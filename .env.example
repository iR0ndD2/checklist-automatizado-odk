# Copie este arquivo para .env e ajuste. O .env nunca vai para o GitHub (está no .gitignore).

# demo = usa as respostas de exemplo da pasta exemplos/ (não precisa de ODK Central)
# odk  = busca as respostas no seu servidor ODK Central
MODO=demo

# ODK Central (só no modo odk). Crie um usuário só para o integrador, com acesso de leitura ao projeto.
ODK_URL=https://odk.seudominio.com.br
ODK_EMAIL=integrador@seudominio.com.br
ODK_SENHA=
ODK_PROJETO_ID=1

# Senha do PostgreSQL usada pelo docker-compose
BANCO_SENHA=troque-esta-senha

# E-mail. O padrão aponta para a caixa de teste (Mailpit) do docker-compose.
SMTP_HOST=email
SMTP_PORTA=1025
SMTP_USUARIO=
SMTP_SENHA=
SMTP_TLS=false
REMETENTE=checklist@seudominio.com.br

# De quantos em quantos minutos buscar respostas novas
INTERVALO_MINUTOS=5
